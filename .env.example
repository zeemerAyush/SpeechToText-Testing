# Copy to .env and edit. Never commit .env.
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=speech_to_text

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=480

STORAGE_DIR=storage
MAX_UPLOAD_MB=500
MAX_DURATION_SEC=7200

# Set true once ffprobe is on PATH. When false, a Python-only fallback validates
# audio, which is weaker (cannot decode WebM, for example).
REQUIRE_FFPROBE=false

# --- Worker / models (read by the worker and by python -m worker.cli) ---
# scripts/download_models.py prints the exact WHISPER_MODEL_DIR and PYANNOTE_CONFIG values to use.
DEVICE=cuda
WHISPER_MODEL=large-v3
# WHISPER_MODEL_DIR=/path/to/SpeechToText-Testing/models/whisper/large-v3
# PYANNOTE_CONFIG=/path/to/SpeechToText-Testing/models/pyannote/config.yaml
SPACY_MODEL=en_core_web_lg
# DENOISE=0                       # set to 0 to skip DeepFilterNet
# INITIAL_PROMPT_FILE=/path/to/prompt.txt
